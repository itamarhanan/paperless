# Copy to .env.local and fill in. Never commit real keys.
# Every key is optional: without them the reader works fully, and readers can
# still use AI by adding their own Gemini key in Appearance › Pages and AI.

# Google AI Studio key (https://aistudio.google.com/apikey): page checks, Discover ideas, and chat fallback
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq key (https://console.groq.com/keys): "Ask about this page"
GROQ_API_KEY=

# AI requests allowed on the site's keys per day, across everyone. 0 turns the shared keys off.
AI_DAILY_LIMIT=2000

# Public address, for link previews and identifying the app to Open Library and Gutenberg.
# On Vercel this defaults to the production domain.
NEXT_PUBLIC_SITE_URL=

# Optional model overrides
CLEANUP_MODEL=gemini-flash-lite-latest
DISCOVER_MODEL=gemini-2.5-flash
CHAT_MODEL=openai/gpt-oss-120b
CHAT_GEMINI_MODEL=gemini-2.5-flash
