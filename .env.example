# Copy to .env.local and fill in. Never commit real keys.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: Gemini model used to clean up extracted page text
CLEANUP_MODEL=gemini-flash-lite-latest
PLAYWRIGHT_BROWSERS_PATH=0
# Optional: Groq model for "Ask about this page"
CHAT_MODEL=openai/gpt-oss-120b
# Book suggestions in Discover
DISCOVER_MODEL=gemini-2.5-flash
